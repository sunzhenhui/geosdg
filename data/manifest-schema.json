{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geosdg.org/schemas/manifest-v2.json",
  "title": "GeoSDG Data Manifest",
  "description": "GeoSDG 评估系统的标准化数据清单格式。引擎通过读取此文件自动发现所有数据、场景、指标配置。",
  "type": "object",
  "required": ["project", "datasets"],
  "$defs": {
    "priority_rule_inline": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "condition": {
          "type": "object",
          "required": ["indicator", "operator"],
          "properties": {
            "indicator": {"type": "string"},
            "dataset": {"type": "string"},
            "operator": {
              "type": "string",
              "enum": ["<", "<=", ">", ">=", "==", "!="]
            },
            "value": {"type": "number"},
            "ranking": {
              "type": "string",
              "enum": ["top", "bottom"]
            },
            "percentile": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "distance": {
              "type": "number",
              "description": "空间分析缓冲距离"
            }
          }
        },
        "aggregation": {
          "type": "string",
          "enum": ["weighted_sum", "geometric_mean", "min", "max", "fuzzy_and", "fuzzy_or"]
        },
        "sub_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"type": "string", "description": "通过 ID 引用另一个规则"},
              {"$ref": "#/$defs/priority_rule_inline"}
            ]
          },
          "description": "子规则（支持 ID 引用和行内定义）"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"type": {"const": "composite"}}
          },
          "then": {
            "required": ["aggregation", "sub_rules"]
          }
        },
        {
          "if": {
            "properties": {"type": {"enum": ["threshold", "ranking", "spatial", "change_rate"]}}
          },
          "then": {
            "required": ["condition"]
          }
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string",
      "description": "指向本 schema 文件的路径，用于 IDE 自动补全和验证"
    },
    "project": {
      "type": "object",
      "required": ["name", "region", "time_range"],
      "properties": {
        "name": {
          "type": "string",
          "description": "项目名称，如 'Beijing Urban Sustainability Assessment 2024'"
        },
        "description": {
          "type": "string",
          "description": "项目描述"
        },
        "region": {
          "type": "object",
          "required": ["name", "bbox", "crs"],
          "properties": {
            "name": {"type": "string"},
            "bbox": {
              "type": "array",
              "items": {"type": "number"},
              "minItems": 4,
              "maxItems": 4,
              "description": "[xmin, ymin, xmax, ymax]"
            },
            "crs": {
              "type": "string",
              "default": "EPSG:4326",
              "description": "坐标参考系，如 EPSG:4326"
            }
          }
        },
        "time_range": {
          "type": "object",
          "required": ["baseline", "horizon", "step"],
          "properties": {
            "baseline": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2100,
              "description": "基准年"
            },
            "horizon": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2200,
              "description": "终期年"
            },
            "step": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "时间步长（年）"
            }
          }
        }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "resolution", "files"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "数据集唯一标识，小写字母+下划线"
          },
          "name": {
            "type": "string",
            "description": "数据集显示名称"
          },
          "category": {
            "type": "string",
            "enum": ["population", "landuse", "infrastructure", "auxiliary", "climate", "economic", "custom"],
            "description": "数据分类"
          },
          "description": {"type": "string"},
          "resolution": {
            "type": "object",
            "required": ["value", "unit"],
            "properties": {
              "value": {"type": "number", "minimum": 0},
              "unit": {"type": "string", "enum": ["m", "km", "degree"]}
            }
          },
          "citation": {
            "type": "object",
            "properties": {
              "text": {"type": "string"},
              "doi": {"type": "string", "pattern": "^10\\."},
              "url": {"type": "string", "format": "uri"}
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "year"],
              "properties": {
                "path": {
                  "type": "string",
                  "description": "相对于 data/ 目录的文件路径"
                },
                "year": {
                  "type": "integer",
                  "minimum": 1900,
                  "maximum": 2200
                },
                "scenario": {
                  "type": ["string", "null"],
                  "description": "场景 ID，必须是 scenarios 中已声明的 ID 或 null（基准数据）",
                  "default": null
                },
                "region": {
                  "type": "string",
                  "description": "区域标识，用于多区域对比"
                },
                "nodata": {
                  "type": "number",
                  "description": "无数据值",
                  "default": -9999
                },
                "tags": {
                  "type": "array",
                  "items": {"type": "string"},
                  "description": "标签，如 ['baseline', 'observed']"
                },
                "md5": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$",
                  "description": "文件 MD5 校验值（可选）"
                }
              }
            }
          },
          "subcategories": {
            "type": "array",
            "description": "子类别定义，用于基础设施等多类型数据集",
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "name": {"type": "string"},
                "description": {"type": "string"},
                "sdg_targets": {
                  "type": "array",
                  "items": {"type": ["number", "string"]},
                  "description": "关联的 SDG 子目标编号（如 3.8、'9c'、'4a'）"
                },
                "files": {
                  "type": "array",
                  "items": {"$ref": "#/properties/datasets/items/properties/files/items"}
                }
              }
            }
          },
          "legend": {
            "type": "object",
            "description": "分类图例映射（土地利用等需要分类的数据）",
            "additionalProperties": {"type": "integer"},
            "examples": [
              {"cropland": 1, "forest": 2, "grassland": 3, "water": 4, "urban": 5}
            ]
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "description": "情景定义，不限于 SSP/RCP，用户可自定义任意情景",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "场景唯一标识"
          },
          "name": {
            "type": "string",
            "description": "场景显示名"
          },
          "family": {
            "type": "string",
            "enum": ["SSP", "RCP", "LOCAL", "CUSTOM"],
            "description": "场景族，用于分组和比较"
          },
          "description": {"type": "string"},
          "parent_scenario": {
            "type": "string",
            "description": "父场景 ID（如 ssp2 是 ssp2_rcp4.5 的父场景）"
          }
        }
      }
    },
    "indicators": {
      "type": "array",
      "description": "待计算的 SDG 指标列表及参数",
      "items": {
        "type": "object",
        "required": ["id", "sdg_goal", "name", "required_datasets"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sdg_\\d+(_\\d+)*$",
            "description": "指标 ID，如 sdg_11_3_1"
          },
          "sdg_goal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 17
          },
          "sdg_target": {
            "type": "number",
            "description": "SDG 子目标编号，如 11.3"
          },
          "sdg_indicator": {
            "type": "string",
            "description": "UN SDG 指标编号，如 '11.3.1'"
          },
          "name": {"type": "string"},
          "description": {"type": "string"},
          "unit": {"type": "string"},
          "required_datasets": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1,
            "description": "依赖的数据集 ID 列表"
          },
          "params": {
            "type": "object",
            "description": "指标计算参数（自由 JSON）"
          },
          "direction": {
            "type": "string",
            "enum": ["positive", "negative"],
            "description": "指标方向：positive 越大越好，negative 越小越好",
            "default": "positive"
          }
        }
      }
    },
    "priority_areas": {
      "type": "object",
      "description": "优先区域识别规则配置",
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string", "description": "通过 ID 引用顶层规则"},
              {"$ref": "#/$defs/priority_rule_inline"}
            ]
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "n_classes": {
              "type": "integer",
              "minimum": 2,
              "maximum": 10,
              "default": 5
            },
            "labels": {
              "type": "array",
              "items": {"type": "string"}
            },
            "classification": {
              "type": "string",
              "enum": ["equal_interval", "quantile", "natural_breaks", "manual"],
              "default": "quantile"
            },
            "breaks": {
              "type": "array",
              "items": {"type": "number"},
              "description": "手动分类断点（classification=manual 时使用）"
            }
          }
        }
      }
    },
    "legacy_mapping": {
      "type": "object",
      "description": "旧格式目录到新格式的映射规则",
      "additionalProperties": {
        "type": "object",
        "required": ["category", "pattern"],
        "properties": {
          "category": {
            "type": "string",
            "enum": ["population", "landuse", "infrastructure", "auxiliary", "climate", "economic", "custom"]
          },
          "pattern": {
            "type": "string",
            "description": "路径模式，如 '{year}/{scenario}/{indicator}.tif'"
          },
          "scenario_map": {
            "type": "object",
            "description": "目录名到场景 ID 的映射",
            "additionalProperties": {"type": "string"}
          },
          "indicator_map": {
            "type": "object",
            "description": "文件名到子类别 ID 的映射",
            "additionalProperties": {"type": "string"}
          }
        }
      }
    }
  }
}
