{
  "name": "priority-loss",
  "category": "priority-area",
  "cli_command": "geosdg-cli",
  "cli_subcommand": "priority-loss",
  "description": "优先区域规则 1：识别被侵蚀的土地。比较两期 LUCC，提取初始期为目标地类、变化期变为非目标地类的像元（即被侵占的地类）。输出优先区域 GeoTIFF。",
  "parameters": {
    "type": "object",
    "properties": {
      "init_lucc": {
        "type": "string",
        "format": "filepath",
        "extensions": [
          ".tif",
          ".tiff"
        ],
        "description": "初始期 LUCC GeoTIFF 路径（GDT_Byte）",
        "required": true
      },
      "curr_lucc": {
        "type": "string",
        "format": "filepath",
        "extensions": [
          ".tif",
          ".tiff"
        ],
        "description": "变化期 LUCC GeoTIFF 路径（GDT_Byte）",
        "required": true
      },
      "output": {
        "type": "string",
        "format": "filepath",
        "description": "输出优先区域 GeoTIFF 路径",
        "required": true
      },
      "types": {
        "type": "string",
        "format": "comma-list",
        "description": "被侵蚀的目标地类编码集合（如 2,3 表示森林和草地被侵占）",
        "required": true
      }
    },
    "required": [
      "init_lucc",
      "curr_lucc",
      "output",
      "types"
    ]
  },
  "returns": {
    "type": "object",
    "properties": {
      "output_file": {
        "type": "string",
        "description": "生成的优先区域 GeoTIFF 路径"
      },
      "status": {
        "type": "string",
        "description": "执行状态：success / failed"
      }
    }
  },
  "input_constraints": {
    "data_type": "GDT_Byte",
    "dimensions": "init_lucc 与 curr_lucc 行列数必须完全一致",
    "projection": "两期数据投影坐标系必须一致"
  },
  "timeout_seconds": 120,
  "output_format": "stdout: Output: <path>",
  "examples": [
    {
      "description": "识别被建设用地侵占的森林和草地",
      "params": {
        "init_lucc": "/data/LUCC/2025.tif",
        "curr_lucc": "/data/LUCC/2050.tif",
        "output": "/data/PriorityAreas-1.tif",
        "types": "2,3"
      }
    }
  ],
  "validation": {
    "rules_file": "agent/validation/rules/priority-loss.json"
  }
}
